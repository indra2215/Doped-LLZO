{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 🔬 CHGNet GPU Structural Relaxation Notebook\n",
    "### Doped-LLZO Solid-State Electrolyte Discovery\n",
    "\n",
    "This notebook performs high-speed GPU-accelerated structural relaxation of charge-balanced **Doped-LLZO garnet candidates** using the **CHGNet Universal Neural Network Potential**.\n",
    "\n",
    "Run this notebook on **Google Colab** (with a GPU T4/V100/A100 runtime) to evaluate candidates in minutes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install Dependencies\n",
    "!pip install -q chgnet pymatgen pandas numpy matplotlib joblib tqdm"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: GPU Environment Verification & CHGNet Model Load\n",
    "import torch\n",
    "import warnings\n",
    "from chgnet.model import CHGNet\n",
    "from chgnet.model.dynamics import StructOptimizer\n",
    "\n",
    "warnings.filterwarnings(\"ignore\")\n",
    "\n",
    "cuda_available = torch.cuda.is_available()\n",
    "device = \"cuda\" if cuda_available else \"cpu\"\n",
    "print(f\"CUDA Available: {cuda_available}\")\n",
    "if cuda_available:\n",
    "    print(f\"Using GPU: {torch.cuda.get_device_name(0)}\")\n",
    "else:\n",
    "    print(\"Running on CPU — enable GPU acceleration via Runtime > Change runtime type in Colab.\")\n",
    "\n",
    "print(\"Loading CHGNet model...\")\n",
    "chgnet = CHGNet.load()\n",
    "optimizer = StructOptimizer(model=chgnet, use_device=device)\n",
    "print(\"CHGNet successfully loaded on device:\", device)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Define Base LLZO Garnet Structure & Substitutions\n",
    "import random\n",
    "from pymatgen.core import Structure, Lattice\n",
    "from pymatgen.io.ase import AseAtomsAdaptor\n",
    "\n",
    "def get_base_llzo():\n",
    "    \"\"\"Build 192-atom cubic LLZO garnet base structure (Ia-3d).\"\"\"\n",
    "    s = Structure.from_spacegroup(\n",
    "        'Ia-3d',\n",
    "        Lattice.cubic(12.98),\n",
    "        ['Li', 'Li', 'La', 'Zr', 'O'],\n",
    "        [\n",
    "            [0.375, 0.0, 0.25],       # 24d Li\n",
    "            [0.098, 0.686, 0.577],    # 96h Li\n",
    "            [0.125, 0.0, 0.25],       # 24c La\n",
    "            [0, 0, 0],                # 16a Zr\n",
    "            [0.282, 0.096, 0.194]     # 96h O\n",
    "        ]\n",
    "    )\n",
    "    li_indices = [i for i, site in enumerate(s) if site.species_string == 'Li']\n",
    "    li_96h_indices = li_indices[24:]\n",
    "    random.seed(42)\n",
    "    to_delete = random.sample(li_96h_indices, 64)\n",
    "    s.remove_sites(to_delete)\n",
    "    return s\n",
    "\n",
    "def build_substituted_structure(base_structure, formula):\n",
    "    \"\"\"Substitute dopants into LLZO lattice sites.\"\"\"\n",
    "    atoms = AseAtomsAdaptor.get_atoms(base_structure)\n",
    "    syms  = list(atoms.get_chemical_symbols())\n",
    "    li_idx = [i for i, s in enumerate(syms) if s == \"Li\"]\n",
    "    la_idx = [i for i, s in enumerate(syms) if s == \"La\"]\n",
    "    zr_idx = [i for i, s in enumerate(syms) if s == \"Zr\"]\n",
    "\n",
    "    dopants = formula\n",
    "    if \"Al\" in dopants and len(li_idx) > 0: syms[li_idx[0]] = \"Al\"\n",
    "    if \"Ga\" in dopants and len(li_idx) > 1: syms[li_idx[1]] = \"Ga\"\n",
    "    if \"Nb\" in dopants and len(zr_idx) > 0: syms[zr_idx[0]] = \"Nb\"\n",
    "    if \"Ta\" in dopants and len(zr_idx) > 1: syms[zr_idx[1]] = \"Ta\"\n",
    "    if \"Gd\" in dopants and len(la_idx) > 0: syms[la_idx[0]] = \"Gd\"\n",
    "    if \"Mg\" in dopants and len(li_idx) > 2: syms[li_idx[2]] = \"Mg\"\n",
    "    if \"Sr\" in dopants and len(la_idx) > 1: syms[la_idx[1]] = \"Sr\"\n",
    "    if \"Y\"  in dopants and \"Yb\" not in dopants and len(la_idx) > 3: syms[la_idx[3]] = \"Y\"\n",
    "    if \"Hf\" in dopants and len(zr_idx) > 2: syms[zr_idx[2]] = \"Hf\"\n",
    "    if \"W\"  in dopants and len(zr_idx) > 3: syms[zr_idx[3]] = \"W\"\n",
    "    if \"Sb\" in dopants and len(zr_idx) > 4: syms[zr_idx[4]] = \"Sb\"\n",
    "    if \"Fe\" in dopants and len(li_idx) > 4: syms[li_idx[4]] = \"Fe\"\n",
    "    if \"Zn\" in dopants and len(li_idx) > 5: syms[li_idx[5]] = \"Zn\"\n",
    "    if \"Ti\" in dopants and len(zr_idx) > 5: syms[zr_idx[5]] = \"Ti\"\n",
    "    if \"Sn\" in dopants and len(zr_idx) > 6: syms[zr_idx[6]] = \"Sn\"\n",
    "    if \"Ba\" in dopants and len(la_idx) > 2: syms[la_idx[2]] = \"Ba\"\n",
    "    if \"Ca\" in dopants and len(la_idx) > 3: syms[la_idx[3]] = \"Ca\"\n",
    "\n",
    "    atoms.set_chemical_symbols(syms)\n",
    "    return AseAtomsAdaptor.get_structure(atoms)\n",
    "\n",
    "print(\"Base structure builder initialized.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Staged Relaxation Algorithm\n",
    "import numpy as np\n",
    "\n",
    "def staged_relax(structure, chgnet_model, optimizer):\n",
    "    \"\"\"\n",
    "    Step 1: Relax atomic positions only (fmax=0.1, steps=200)\n",
    "    Step 2: Relax full cell + atoms (relax_cell=True, fmax=0.05, steps=300)\n",
    "    \"\"\"\n",
    "    # Step 1: positions only\n",
    "    try:\n",
    "        res1 = optimizer.relax(structure, relax_cell=False, fmax=0.1, steps=200, verbose=False)\n",
    "        pos_relaxed = res1['final_structure']\n",
    "    except Exception as e:\n",
    "        print(f\"  [relax] Step 1 failed ({e}). Falling back to static.\")\n",
    "        pred = chgnet_model.predict_structure(structure)\n",
    "        return structure, float(pred['e']), 'static'\n",
    "\n",
    "    # Step 2: full cell + atoms\n",
    "    try:\n",
    "        res2 = optimizer.relax(pos_relaxed, relax_cell=True, fmax=0.05, steps=300, verbose=False)\n",
    "        final = res2['final_structure']\n",
    "        pred  = chgnet_model.predict_structure(final)\n",
    "        e = float(pred['e'])\n",
    "        v = float(final.volume / len(final))\n",
    "        if not np.isfinite(v) or v <= 0:\n",
    "            raise ValueError(f\"Invalid volume: {v}\")\n",
    "        return final, e, 'full'\n",
    "    except Exception as e:\n",
    "        print(f\"  [relax] Step 2 failed ({e}). Using position-only result.\")\n",
    "        pred = chgnet_model.predict_structure(pos_relaxed)\n",
    "        return pos_relaxed, float(pred['e']), 'pos_only'\n",
    "\n",
    "print(\"Staged relaxation algorithm ready.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Evaluate Candidates\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "\n",
    "# Sample candidate formulas to evaluate\n",
    "candidates = [\n",
    "    \"Li6.4La3.0Zr1.4Ta0.6O12\",\n",
    "    \"Li6.4La2.95Gd0.05Zr1.4Ta0.6O12\",\n",
    "    \"Li6.45La2.95Ca0.05Zr1.4Ta0.6O12\",\n",
    "    \"Li6.45La2.95Ba0.05Zr1.4Ta0.6O12\",\n",
    "    \"Li6.35Ga0.05La2.9Ca0.1Zr1.4Ta0.6O12\",\n",
    "    \"Li6.500Mg0.25La3Zr1.75Nb0.25O12\",\n",
    "    \"Li6.500Fe0.10La3Zr1.80Nb0.20O12\",\n",
    "    \"Li6.500Zn0.10La3Zr1.70Nb0.30O12\"\n",
    "]\n",
    "\n",
    "base_struct = get_base_llzo()\n",
    "results = []\n",
    "output_dir = Path(\"relaxed_structures\")\n",
    "output_dir.mkdir(exist_ok=True)\n",
    "\n",
    "print(f\"Evaluating {len(candidates)} candidate structures on {device.upper()}...\")\n",
    "for idx, formula in enumerate(candidates):\n",
    "    print(f\"[{idx+1}/{len(candidates)}] {formula}\")\n",
    "    try:\n",
    "        sub_struct = build_substituted_structure(base_struct, formula)\n",
    "        relaxed_struct, energy_per_atom, mode = staged_relax(sub_struct, chgnet, optimizer)\n",
    "        volume_per_atom = relaxed_struct.volume / len(relaxed_struct)\n",
    "        \n",
    "        # Save CIF\n",
    "        cif_path = output_dir / f\"{formula}_relaxed.cif\"\n",
    "        relaxed_struct.to(fmt=\"cif\", filename=str(cif_path))\n",
    "        \n",
    "        results.append({\n",
    "            \"formula\": formula,\n",
    "            \"relaxed_energy_per_atom_eV\": energy_per_atom,\n",
    "            \"relaxed_volume_per_atom_A3\": volume_per_atom,\n",
    "            \"relax_mode\": mode\n",
    "        })\n",
    "        print(f\"  -> [{mode}] Energy: {energy_per_atom:.4f} eV/atom | Volume: {volume_per_atom:.3f} A^3/atom\")\n",
    "    except Exception as e:\n",
    "        print(f\"  -> Failed: {e}\")\n",
    "\n",
    "df_results = pd.DataFrame(results)\n",
    "df_results.to_csv(\"evaluated_candidates.csv\", index=False)\n",
    "print(\"\\nEvaluation complete! Results saved to evaluated_candidates.csv\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Summary & Plot\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "if not df_results.empty:\n",
    "    print(df_results.to_string(index=False))\n",
    "    \n",
    "    fig, ax1 = plt.subplots(figsize=(10, 5))\n",
    "    ax1.set_title(\"CHGNet Relaxed Energy and Volume per Composition\")\n",
    "    ax1.bar(df_results['formula'], df_results['relaxed_volume_per_atom_A3'], color='skyblue', alpha=0.7, label='Volume (A^3/atom)')\n",
    "    ax1.set_ylabel(\"Volume per Atom (A^3)\", color='blue')\n",
    "    plt.xticks(rotation=45, ha='right')\n",
    "    \n",
    "    ax2 = ax1.twinx()\n",
    "    ax2.plot(df_results['formula'], df_results['relaxed_energy_per_atom_eV'], color='red', marker='o', label='Energy (eV/atom)')\n",
    "    ax2.set_ylabel(\"Energy per Atom (eV)\", color='red')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  }
 ],
 "metadata": {
  "language_info": {
   "name": "python"
  }
 },
 "nbformat": 4,
 "nbformat_minor": 2
}

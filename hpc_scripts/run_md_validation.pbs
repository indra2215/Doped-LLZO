#!/bin/bash
#PBS -N md_validation
#PBS -l nodes=1:ppn=16
#PBS -l mem=128gb
#PBS -l walltime=24:00:00
#PBS -j oe
#PBS -o md_validation.log

echo "=== MD Validation Job Started ==="
echo "Node: $(hostname)"
echo "Date: $(date)"

module load python/3.10
module load cuda/11.8      # Strongly recommended: GPU will speed up CHGNet 10-50x

cd /path/to/doped_2        # <<< CHANGE THIS to your HPC project path
source venv/bin/activate   # <<< CHANGE THIS to your venv path

# Use full mode for production MD (set FAST_MODE=False for 500k steps / 1ns)
# Or keep FAST_MODE=True for quick 5k steps / 10ps validation
echo "Running backtrack_validation_corrected.py..."
python 02_pipeline/step5_md_validation/backtrack_validation_corrected.py

# After success, copy results to final output
echo "Copying results to FINAL_Results..."
cp 01_data/results/finalresults.csv FINAL_Results/High_Performance_Pipeline/finalresults.csv

echo "=== Job Finished at $(date) ==="

#!/bin/bash
#PBS -N dynamical_stability
#PBS -l nodes=1:ppn=8
#PBS -l mem=64gb
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o dynamical_stability.log

echo "=== Dynamical Stability Job Started ==="
echo "Node: $(hostname)"
echo "Date: $(date)"

# Load modules (adjust to your HPC environment)
module load python/3.10
module load cuda/11.8      # Optional: for GPU acceleration

# Navigate to project root
cd /path/to/doped_2        # <<< CHANGE THIS to your HPC project path

# Activate your virtual environment
source venv/bin/activate   # <<< CHANGE THIS to your venv path

echo "Running dynamical_stability.py..."
python 02_pipeline/step4_stability/dynamical_stability.py

echo "=== Job Finished at $(date) ==="
